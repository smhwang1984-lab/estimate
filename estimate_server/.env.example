# .env 로 복사해서 필요한 값만 고친다. .env 가 없으면 아래 기본값이 쓰인다.
ESTIMATE_PORT=8100
ESTIMATE_ALLOWED_CIDRS=192.168.0.0/24,192.168.10.0/24
ESTIMATE_BACKUP_ENABLED=1
ESTIMATE_BACKUP_AT=23:40
ESTIMATE_BACKUP_RETENTION_DAYS=30
# 편집 암호를 잊었을 때만 1로 바꾸고 컨테이너를 다시 띄운다(암호가 지워진다). 끝나면 0으로 되돌린다.
ESTIMATE_RESET_EDIT_PASSWORD=0
